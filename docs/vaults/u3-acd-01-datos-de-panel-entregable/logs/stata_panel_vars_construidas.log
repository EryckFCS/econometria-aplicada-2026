>     country(ARG;BOL;BRA;CHL;COL;ECU;PRY;PER;URY;VEN) 
>     year(2001:2023) 
>     clear 
>     long;
> #delimit cr
> 
> * Renombrar variables y guardar base
> rename ny_gdp_totl_rt_zs VE
> rename bx_klt_dinv_wd_gd_zs IE
> rename fs_ast_prvt_gd_zs AN
> encode countryname, gen(country_id)
> xtset country_id year
> save "`base_path'/data/processed/panel_paises_api.dta", replace
> */
. 
. * 2. Importación y declaración del panel cantonal (Ecuador)
. import delimited "`base_path'/data/processed/panel_cantonal_consolidado.csv", stringcols(3) clear
(encoding automatically selected: UTF-8)
(12 vars, 2,210 obs)

. encode codigo_canton, gen(canton_id_num)

. encode vab_group,     gen(vab_group_num)

. xtset canton_id_num anio, yearly

Panel variable: canton_id_num (strongly balanced)
 Time variable: anio, 2015 to 2024
         Delta: 1 year

. 
. * 3. Construcción de variables
. gen LE = ln(empleo_prom)

. gen PR = ln(vab / empleo_prom)

. gen PR2 = PR^2

. gen TE = ln(ventas_totales / num_emp)

. gen DE = ln(empleo_prom / num_emp)

. gen PP = participacion_provincial

. 
