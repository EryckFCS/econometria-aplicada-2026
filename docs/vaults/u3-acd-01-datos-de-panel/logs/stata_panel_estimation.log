. *==============================================================================*
. * 3. GRÁFICOS DE EVOLUCIÓN
. *==============================================================================*
. di ""


. di ">>> GENERANDO GRÁFICOS DE EVOLUCIÓN TEMPORAL <<<"
>>> GENERANDO GRÁFICOS DE EVOLUCIÓN TEMPORAL <<<

. 
. * Colapsar ventas promedio por año y grupo de VAB para visualizar tendencias
. preserve

.     collapse (mean) ventas_totales, by(year vab_group)

.     
.     * Graficar la evolución temporal por tercil de VAB
.     twoway (line ventas_totales year if vab_group == "Alto", lcolor(navy) lwidth(medthick)) ///
>            (line ventas_totales year if vab_group == "Medio", lcolor(orange) lwidth(medthick)) ///
>            (line ventas_totales year if vab_group == "Bajo", lcolor(forest_green) lwidth(medthick)), ///
>            title("Evolución de Ventas Promedio por Tercil de VAB (2015-2024)") ///
>            xtitle("Año") ytitle("Ventas Promedio (USD)") ///
>            legend(order(1 "Alto" 2 "Medio" 3 "Bajo")) ///
>            xlabel(2015(1)2024, grid)

.            
.     graph export "../assets/evolution_by_vab.png", replace
(file ../assets/evolution_by_vab.png not found)
file ../assets/evolution_by_vab.png saved as PNG format

. restore

. 
