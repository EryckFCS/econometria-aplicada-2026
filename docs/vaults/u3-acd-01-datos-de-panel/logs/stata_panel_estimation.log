. *==============================================================================*
. * 2. ESTIMACIÓN SEGMENTADA POR TERCILES DE VAB (Bajo, Medio, Alto)
. *==============================================================================*
. * Convertir vab_group a variable categórica numérica para Stata
. encode vab_group, gen(vab_group_id)

. 
. levelsof vab_group_id, local(levels)
1 2 3

. foreach l of local levels {
  2.     local grp_label : label vab_group_id `l'
  3.     di ""
  4.     di "======================================================================"
  5.     di "GRUPO DE INGRESO VAB: `grp_label' (ID: `l')"
  6.     di "======================================================================"
  7.     
.     di ">>> EFECTOS FIJOS (FE) - `grp_label' <<<"
  8.     xtreg log_ventas log_empresas log_empleo if vab_group_id == `l', fe
  9.     estimates store fe_`l'
 10.     
.     di ">>> EFECTOS ALEATORIOS (RE) - `grp_label' <<<"
 11.     xtreg log_ventas log_empresas log_empleo if vab_group_id == `l', re
 12.     estimates store re_`l'
 13.     
.     di ">>> TEST DE HAUSMAN - `grp_label' <<<"
 14.     hausman fe_`l' re_`l'
 15. }

